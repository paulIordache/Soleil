#version 460
layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0) uniform sampler2D imgInputDiffuse;
layout(binding = 1) uniform sampler2D imgInputSpecular;
layout(binding = 2, rgba16f) uniform writeonly image2D imgOutputDiffuse;
layout(binding = 3, rgba16f) uniform writeonly image2D imgOutputSpecular;
layout(binding = 4) uniform sampler2D imgNormal;
layout(binding = 5) uniform sampler2D imgDepth;

layout(binding = 6) uniform sampler2D imgMomentsDiffuse;
layout(binding = 7) uniform sampler2D imgMomentsSpecular;

layout(binding = 8, rg16f) uniform writeonly image2D imgOutVarianceDiffuse;
layout(binding = 9, rg16f) uniform writeonly image2D imgOutVarianceSpecular;

layout(push_constant) uniform PushConsts { int step_size; } pc;

const float k[3] = float[](0.25, 0.5, 0.25);

const float sigma_z = 1.0;
const float sigma_n = 512.0;
const float sigma_l = 4.0;

float Luminance(vec3 c) {
    return dot(c, vec3(0.2126, 0.7152, 0.0722));
}

float FetchVarianceDiff(vec2 uv) {
    vec2 data = texture(imgMomentsDiffuse, uv).rg;
    return (pc.step_size == 1) ? max(0.0, data.y - data.x * data.x) : data.x;
}

float FetchVarianceSpec(vec2 uv) {
    vec2 data = texture(imgMomentsSpecular, uv).rg;
    return (pc.step_size == 1) ? max(0.0, data.y - data.x * data.x) : data.x;
}

float GaussianVarianceDiff(vec2 uv, vec2 texelSize) {
    const float gk[3] = float[](0.25, 0.5, 0.25);
    float sum = 0.0, wSum = 0.0;
    for (int y = -1; y <= 1; y++) {
        for (int x = -1; x <= 1; x++) {
            vec2  sUV = uv + vec2(x, y) * texelSize;
            float wG  = gk[x + 1] * gk[y + 1];
            float v   = FetchVarianceDiff(sUV);
            sum  += v * wG;
            wSum += wG;
        }
    }
    return sum / max(wSum, 1e-6);
}

float GaussianVarianceSpec(vec2 uv, vec2 texelSize) {
    const float gk[3] = float[](0.25, 0.5, 0.25);
    float sum = 0.0, wSum = 0.0;
    for (int y = -1; y <= 1; y++) {
        for (int x = -1; x <= 1; x++) {
            vec2  sUV = uv + vec2(x, y) * texelSize;
            float wG  = gk[x + 1] * gk[y + 1];
            float v   = FetchVarianceSpec(sUV);
            sum  += v * wG;
            wSum += wG;
        }
    }
    return sum / max(wSum, 1e-6);
}

void main() {
    ivec2 p    = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(imgOutputDiffuse);
    if (p.x >= size.x || p.y >= size.y) return;

    vec2 texelSize = 1.0 / vec2(size);
    vec2 uv        = (vec2(p) + 0.5) * texelSize;

    vec4 cDiffData = texture(imgInputDiffuse, uv);
    vec3 cDiff = cDiffData.rgb;
    float historyLengthDiff = cDiffData.a;

    vec4 cSpecData = texture(imgInputSpecular, uv);
    vec3 cSpec = cSpecData.rgb;
    float historyLengthSpec = cSpecData.a;

    vec4  cNormalData = texture(imgNormal, uv);
    vec3  cNormal     = cNormalData.xyz;
    float cRoughness  = cNormalData.w;

    float cDepth      = texture(imgDepth, uv).r;
    float dR     = textureOffset(imgDepth, uv, ivec2(1, 0)).r;
    float dU     = textureOffset(imgDepth, uv, ivec2(0, 1)).r;
    vec2  dz_dxy = vec2(dR - cDepth, dU - cDepth);

    float varEpsilon = 1e-4;

    float varDiffFiltered = GaussianVarianceDiff(uv, texelSize);
    float varSpecFiltered = GaussianVarianceSpec(uv, texelSize);

    float stepScale = max(1.0, float(pc.step_size) * 0.5);
    float current_sigma_l = sigma_l / stepScale;

    float phiDiff = current_sigma_l * sqrt(max(varDiffFiltered, varEpsilon));
    float sigma_l_spec = current_sigma_l * clamp(cRoughness * 2.0, 0.05, 1.0);
    float specVarFloor = max(varEpsilon * cRoughness * cRoughness, varEpsilon * 0.001);
    float phiSpec      = sigma_l_spec * sqrt(max(varSpecFiltered, specVarFloor));

    float cLumaDiff = dot(cDiff, vec3(0.2126, 0.7152, 0.0722));
    float cLumaSpec = dot(cSpec, vec3(0.2126, 0.7152, 0.0722));

    vec3  sumDiff  = vec3(0.0);
    vec3  sumSpec  = vec3(0.0);
    float sumWDiff = 0.0;
    float sumWSpec = 0.0;

    float varNumerDiff = 0.0;
    float varNumerSpec = 0.0;

    for (int y = -1; y <= 1; y++) {
        for (int x = -1; x <= 1; x++) {
            vec2 nUV = uv + vec2(x, y) * float(pc.step_size) * texelSize;
            if (any(lessThan(nUV, vec2(0.0))) || any(greaterThan(nUV, vec2(1.0)))) continue;

            float kw = k[x + 1] * k[y + 1];

            vec3  nDiff  = texture(imgInputDiffuse,  nUV).rgb;
            vec3  nSpec  = texture(imgInputSpecular, nUV).rgb;
            vec3  nNorm  = texture(imgNormal, nUV).xyz;
            float nDepth = texture(imgDepth,  nUV).r;

            vec2  offset    = vec2(float(x), float(y)) * float(pc.step_size);
            float depthDiff = abs(cDepth - nDepth);
            float expectedDepthDiff = abs(dot(dz_dxy, offset));
            float depthTolerance = sigma_z * expectedDepthDiff + 1e-4;
            float wDepth = exp(-depthDiff / depthTolerance);

            float wNormal = pow(max(0.0, dot(cNormal, nNorm)), sigma_n);
            float wNormalSpec = pow(max(0.0, dot(cNormal, nNorm)), sigma_n + (1.0 - cRoughness) * 512.0);

            float nLumaDiff = dot(nDiff, vec3(0.2126, 0.7152, 0.0722));
            float nLumaSpec = dot(nSpec, vec3(0.2126, 0.7152, 0.0722));

            float wLumaDiff = exp(-abs(cLumaDiff - nLumaDiff) / max(phiDiff, 1e-5));
            float wLumaSpec = exp(-abs(cLumaSpec - nLumaSpec) / max(phiSpec, 1e-5));

            float nRoughness = texture(imgNormal, nUV).w;
            float wRoughEdge = exp(-abs(cRoughness - nRoughness) / 0.01);

            float wDiff = kw * wDepth * wNormal * wLumaDiff;
            float wSpec = kw * wDepth * wNormalSpec * wLumaSpec * wRoughEdge;

            if (isnan(wDiff)) wDiff = 0.0;
            if (isnan(wSpec)) wSpec = 0.0;

            sumDiff  += nDiff * wDiff;
            sumSpec  += nSpec * wSpec;
            sumWDiff += wDiff;
            sumWSpec += wSpec;

            float nVarDiff = FetchVarianceDiff(nUV);
            float nVarSpec = FetchVarianceSpec(nUV);

            varNumerDiff += wDiff * wDiff * nVarDiff;
            varNumerSpec += wSpec * wSpec * nVarSpec;
        }
    }

    vec3 outDiff = sumDiff / max(sumWDiff, 1e-6);
    vec3 outSpec = sumSpec / max(sumWSpec, 1e-6);

    float specBlendMask = smoothstep(0.0, 0.05, cRoughness);
    outSpec = mix(cSpec, outSpec, specBlendMask);

    imageStore(imgOutputDiffuse,  p, vec4(outDiff, historyLengthDiff));
    imageStore(imgOutputSpecular, p, vec4(outSpec, historyLengthSpec));

    float propVarDiff = varNumerDiff / max(sumWDiff * sumWDiff, 1e-10);
    float propVarSpec = varNumerSpec / max(sumWSpec * sumWSpec, 1e-10);

    imageStore(imgOutVarianceDiffuse,  p, vec4(propVarDiff, 0.0, 0.0, 0.0));
    imageStore(imgOutVarianceSpecular, p, vec4(propVarSpec, 0.0, 0.0, 0.0));
}